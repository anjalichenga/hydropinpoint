# Required for policy-compliant Nominatim requests and source identification.
CONTACT_EMAIL=your-real-email@example.com

# Supported provider: openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Standard OpenAI API key. Leave blank to use the non-LLM fallback.
LLM_API_KEY=

# Optional; default is .cache
HYDROPINPOINT_CACHE_DIR=.cache
