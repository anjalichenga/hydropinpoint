# Required for policy-compliant Nominatim requests and source identification.
CONTACT_EMAIL=your-real-email@example.com

# Google Gemini configuration.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Create this at https://aistudio.google.com/app/apikey
# Leave blank to use the non-LLM fallback.
GEMINI_API_KEY=

# Optional; default is .cache
HYDROPINPOINT_CACHE_DIR=.cache

# Optional Bengaluru screening boundary (defaults cover roughly 38 x 39 km).
HYDROPINPOINT_BOX_WEST=77.45
HYDROPINPOINT_BOX_SOUTH=12.80
HYDROPINPOINT_BOX_EAST=77.80
HYDROPINPOINT_BOX_NORTH=13.15

# Optional custom/self-hosted Overpass endpoint. Leave blank for public mirrors.
OVERPASS_API_URL=
